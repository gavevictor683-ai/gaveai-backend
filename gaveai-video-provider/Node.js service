const fs = require("fs");
const path = require("path");
const os = require("os");
const crypto = require("crypto");

const PROVIDER_URL =
  process.env.GAVEAI_VIDEO_PROVIDER_URL || "";

const HF_TOKEN =
  process.env.HF_TOKEN || "";

const PROVIDER_TIMEOUT =
  Number(
    process.env.GAVEAI_VIDEO_TIMEOUT_MS || 600000
  );


/*
========================================================
NORMALIZE FILE RESULT
========================================================
*/

function normalizeFileResult(value) {

  if (!value) {
    return null;
  }

  if (typeof value === "string") {
    return value;
  }

  if (typeof value === "object") {

    if (value.url) {
      return value.url;
    }

    if (value.path) {
      return value.path;
    }

    if (value.file) {
      return value.file;
    }

    if (value.name) {
      return value.name;
    }
  }

  return null;
}


/*
========================================================
PARSE SSE
========================================================
*/

function parseSSE(text) {

  const events = [];

  const blocks = text
    .split(/\n\n+/)
    .map((block) => block.trim())
    .filter(Boolean);

  for (const block of blocks) {

    const lines = block.split("\n");

    let event = "";
    let data = "";

    for (const line of lines) {

      if (line.startsWith("event:")) {
        event = line
          .slice("event:".length)
          .trim();
      }

      if (line.startsWith("data:")) {
        data += line
          .slice("data:".length)
          .trim();
      }
    }

    if (event || data) {

      events.push({
        event,
        data
      });

    }
  }

  return events;
}


/*
========================================================
FETCH JSON
========================================================
*/

async function fetchJSON(
  url,
  options = {}
) {

  const controller =
    new AbortController();

  const timeout =
    setTimeout(
      () => controller.abort(),
      PROVIDER_TIMEOUT
    );

  try {

    const response =
      await fetch(
        url,
        {
          ...options,
          signal: controller.signal
        }
      );

    const text =
      await response.text();

    let data;

    try {

      data = JSON.parse(text);

    } catch {

      data = text;

    }

    if (!response.ok) {

      throw new Error(
        `GaveAI Video Provider HTTP ${response.status}: ` +
        (
          typeof data === "string"
            ? data
            : JSON.stringify(data)
        )
      );

    }

    return data;

  } finally {

    clearTimeout(timeout);

  }
}


/*
========================================================
DOWNLOAD GENERATED VIDEO
========================================================
*/

async function downloadVideo(videoUrl) {

  const response =
    await fetch(videoUrl);

  if (!response.ok) {

    throw new Error(
      `Failed to download generated video: HTTP ${response.status}`
    );

  }

  const buffer =
    Buffer.from(
      await response.arrayBuffer()
    );

  const fileName =
    `gaveai-provider-${crypto.randomUUID()}.mp4`;

  const filePath =
    path.join(
      os.tmpdir(),
      fileName
    );

  await fs.promises.writeFile(
    filePath,
    buffer
  );

  return {
    filePath,
    fileName,
    size: buffer.length
  };
}


/*
========================================================
GENERATE VIDEO WITH HUGGING FACE
========================================================
*/

async function generateWithGaveAIVideoProvider({
  prompt,
  numFrames = 49,
  height = 480,
  width = 832,
  guidanceScale = 5
}) {

  if (!PROVIDER_URL) {

    throw new Error(
      "GAVEAI_VIDEO_PROVIDER_URL is not configured."
    );

  }

  if (
    !prompt ||
    typeof prompt !== "string"
  ) {

    throw new Error(
      "Video prompt is required."
    );

  }

  const baseUrl =
    PROVIDER_URL.replace(
      /\/+$/,
      ""
    );


  console.log(
    "========================================"
  );

  console.log(
    "GAVEAI HUGGING FACE VIDEO PROVIDER"
  );

  console.log(
    "PROVIDER:",
    baseUrl
  );

  console.log(
    "PROMPT:",
    prompt
  );

  console.log(
    "========================================"
  );


  const headers = {
    "Content-Type":
      "application/json"
  };


  if (HF_TOKEN) {

    headers.Authorization =
      `Bearer ${HF_TOKEN}`;

  }


  /*
  ======================================================
  STEP 1
  SUBMIT GRADIO JOB
  ======================================================
  */

  const submitResponse =
    await fetchJSON(
      `${baseUrl}/gradio_api/call/generate_video`,
      {
        method: "POST",

        headers,

        body: JSON.stringify({
          data: [
            prompt,
            Number(numFrames),
            Number(height),
            Number(width),
            Number(guidanceScale)
          ]
        })
      }
    );


  const eventId =
    submitResponse?.event_id;


  if (!eventId) {

    throw new Error(
      "Video provider did not return an event_id."
    );

  }


  console.log(
    "VIDEO PROVIDER EVENT ID:",
    eventId
  );


  /*
  ======================================================
  STEP 2
  WAIT FOR GRADIO RESULT
  ======================================================
  */

  const resultResponse =
    await fetch(
      `${baseUrl}/gradio_api/call/generate_video/${eventId}`,
      {
        method: "GET",
        headers
      }
    );


  if (!resultResponse.ok) {

    const errorText =
      await resultResponse.text();

    throw new Error(
      `Video provider result request failed: HTTP ${resultResponse.status} ${errorText}`
    );

  }


  const resultText =
    await resultResponse.text();


  const events =
    parseSSE(resultText);


  let completedData = null;


  for (const item of events) {

    if (item.event === "error") {

      throw new Error(
        `GaveAI Video Provider generation error: ${item.data}`
      );

    }


    if (
      item.event === "complete" &&
      item.data
    ) {

      try {

        completedData =
          JSON.parse(
            item.data
          );

      } catch {

        completedData =
          item.data;

      }

    }

  }


  if (!completedData) {

    throw new Error(
      "Video provider did not return a completed result."
    );

  }


  /*
  ======================================================
  STEP 3
  FIND VIDEO URL
  ======================================================
  */

  let videoValue =
    Array.isArray(completedData)
      ? completedData[0]
      : completedData;


  let videoUrl =
    normalizeFileResult(
      videoValue
    );


  if (
    videoValue &&
    typeof videoValue === "object"
  ) {

    if (videoValue.url) {

      videoUrl =
        videoValue.url;

    } else if (
      videoValue.path &&
      /^https?:\/\//i.test(
        videoValue.path
      )
    ) {

      videoUrl =
        videoValue.path;

    }

  }


  if (!videoUrl) {

    throw new Error(
      "Video provider completed successfully but no video URL was returned."
    );

  }


  console.log(
    "VIDEO PROVIDER VIDEO URL:",
    videoUrl
  );


  /*
  ======================================================
  STEP 4
  DOWNLOAD MP4
  ======================================================
  */

  const downloaded =
    await downloadVideo(
      videoUrl
    );


  console.log(
    "VIDEO DOWNLOADED:",
    downloaded.filePath
  );

  console.log(
    "VIDEO SIZE:",
    downloaded.size
  );


  return {

    success: true,

    provider:
      "huggingface-zerogpu",

    model:
      "Wan-AI/Wan2.2-TI2V-5B-Diffusers",

    sourceUrl:
      videoUrl,

    videoFile:
      downloaded.filePath,

    filePath:
      downloaded.filePath,

    fileName:
      downloaded.fileName,

    fileSize:
      downloaded.size

  };

}


/*
========================================================
EXPORT
========================================================
*/

module.exports = {
  generateWithGaveAIVideoProvider
};